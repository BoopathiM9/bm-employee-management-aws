# Local Development Environment Configuration
# Copy this file to .env for local testing (Do NOT commit .env to Git)

PORT=8080
NODE_ENV=development

# Database Settings (For local testing without Secrets Manager)
USE_SECRETS_MANAGER=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bm_employees_db
DB_USER=postgres
DB_PASSWORD=your_local_password_here

# AWS Secrets Manager Settings (Used when USE_SECRETS_MANAGER=true or NODE_ENV=production)
AWS_REGION=us-east-1
SECRET_NAME=bm_db_credentials

# CORS configuration
CORS_ORIGIN=*
